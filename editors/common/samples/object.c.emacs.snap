>
>/*
#^^ font-lock-comment-delimiter-face
> * A comment of several lines
#^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ font-lock-comment-face
> * before a function.
#^^^^^^^^^^^^^^^^^^^^^ font-lock-comment-face
> */
#^^^ font-lock-comment-delimiter-face
>int
#^^^ font-lock-type-face
>query_count(int which, varargs int fallback)
#^^^^^^^^^^^ font-lock-function-name-face
#            ^^^ font-lock-type-face
#                       ^^^^^^^ font-lock-keyword-face
#                               ^^^ font-lock-type-face
>{
>    int i, total;
#    ^^^ font-lock-type-face
>
>    if (which < 0 || which >= sizeof(counts)) {
#    ^^ font-lock-keyword-face
#                ^ font-lock-number-face
#                              ^^^^^^ font-lock-function-call-face
>        return fallback;
#        ^^^^^^ font-lock-keyword-face
>    }
>    for (i = 0; i < which; i++) {
#    ^^^ font-lock-keyword-face
#             ^ font-lock-number-face
>        total += counts[i];
>    }
>    if (total > 10)
#    ^^ font-lock-keyword-face
#                ^^ font-lock-number-face
>        total = 10;
#                ^^ font-lock-number-face
>    else if (total < 0 &&
#    ^^^^ font-lock-keyword-face
#         ^^ font-lock-keyword-face
#                     ^ font-lock-number-face
>        which > 1) {
#                ^ font-lock-number-face
>        return 0;
#        ^^^^^^ font-lock-keyword-face
#               ^ font-lock-number-face
>    } else
#      ^^^^ font-lock-keyword-face
>        total++;
>    while (total > 5) {
#    ^^^^^ font-lock-keyword-face
#                   ^ font-lock-number-face
>        total--;
>    }
>    do {
#    ^^ font-lock-keyword-face
>        total++;
>    } while (total < 3);
#      ^^^^^ font-lock-keyword-face
#                     ^ font-lock-number-face
>    switch (which) {
#    ^^^^^^ font-lock-keyword-face
>    case 0:
#    ^^^^ font-lock-keyword-face
#         ^ font-lock-number-face
>        total = 0;
#                ^ font-lock-number-face
>        break;
#        ^^^^^ font-lock-keyword-face
>    case 1..2:
#    ^^^^ font-lock-keyword-face
#         ^ font-lock-number-face
#          ^^ font-lock-operator-face
#            ^ font-lock-number-face
>        total = call_other(this_object(), "query_bonus",
#                ^^^^^^^^^^ font-lock-function-call-face
#                           ^^^^^^^^^^^ font-lock-function-call-face
#                                          ^^^^^^^^^^^^^ font-lock-string-face
>            which, total);
>        break;
#        ^^^^^ font-lock-keyword-face
>    default:
#    ^^^^^^^ font-lock-keyword-face
>        break;
#        ^^^^^ font-lock-keyword-face
>    }
>#ifdef DEBUG
#^^^^^^ font-lock-preprocessor-face
>    write("total: " + total + "\n");
#    ^^^^^ font-lock-function-call-face
#          ^^^^^^^^^ font-lock-string-face
#                              ^^^^ font-lock-string-face
>#endif
#^^^^^^ font-lock-preprocessor-face
>    return total;
#    ^^^^^^ font-lock-keyword-face
>}
>
>string
#^^^^^^ font-lock-type-face
>query_exit(string dir)
#^^^^^^^^^^ font-lock-function-name-face
#           ^^^^^^ font-lock-type-face
>{
>    string dest;
#    ^^^^^^ font-lock-type-face
>
>    dest = exits[dir];
>    if (!dest) {
#    ^^ font-lock-keyword-face
>        // nothing that way
#        ^^^ font-lock-comment-delimiter-face
#           ^^^^^^^^^^^^^^^^ font-lock-comment-face
>        return nil;
#        ^^^^^^ font-lock-keyword-face
#               ^^^ font-lock-constant-face
>    }
>    return catch (dest->load()) ? nil : dest;
#    ^^^^^^ font-lock-keyword-face
#           ^^^^^ font-lock-keyword-face
#                      ^^ font-lock-operator-face
#                        ^^^^ font-lock-function-call-face
#                                  ^^^ font-lock-constant-face
