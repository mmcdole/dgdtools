>        n = 2;
#            ^ font-lock-number-face
>    } else
#      ^^^^ font-lock-keyword-face
>        return;
#        ^^^^^^ font-lock-keyword-face
>    for (i = 0; i < n; i++)
#    ^^^ font-lock-keyword-face
#             ^ font-lock-number-face
>        continue;
#        ^^^^^^^^ font-lock-keyword-face
>    while (n--)
#    ^^^^^ font-lock-keyword-face
>        break;
#        ^^^^^ font-lock-keyword-face
>    do {
#    ^^ font-lock-keyword-face
>        n++;
>    } while (n < 10);
#      ^^^^^ font-lock-keyword-face
#                 ^^ font-lock-number-face
>    switch (n) {
#    ^^^^^^ font-lock-keyword-face
>    case 1:
#    ^^^^ font-lock-keyword-face
